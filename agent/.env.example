# Copy to .env and fill in. Never commit .env.

# LiveKit Cloud project (Settings -> Keys)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# Primary LLM for every text call (voice interviewer, observer, scope check, planner, scorer)
OPENROUTER_API_KEY=
# Fallback LLM + embeddings. Paid-tier key for real candidate data (free-tier data may be used by Google)
GOOGLE_API_KEY=

# Qdrant Cloud cluster (Cluster -> API keys). Leave QDRANT_API_KEY empty for a local Qdrant.
# Use the https endpoint ending in :6333.
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Optional overrides
# ELEVENLABS_VOICE_ID=
# OPENROUTER_MODEL=openai/gpt-6-luna
# Gemini fallbacks per role:
# INTERVIEWER_MODEL=gemini-3.8-flash
# OBSERVER_MODEL=gemini-3.5-flash-lite
# PLANNER_MODEL=gemini-4-argon
# SCORER_MODEL=gemini-4-argon
# EMBED_MODEL=gemini-embedding-2
# INTERVIEWER_THINKING=minimal
# OPENROUTER_REASONING=low
# RAG_MIN_SCORE=0.5

# Backend link (backend/ reads these too). Generate the token once: python -c "import secrets; print(secrets.token_urlsafe(32))"
GURU_API_URL=http://localhost:8080
GURU_SERVICE_TOKEN=
