    {
      "dot": "rose",
      "title": "ConsentTask(AgentTask[bool])  ·  interviewer.py",
      "items": [
        "vars: (none; instructions from prompts.CONSENT)",
        "__init__(s: State)",
        "async on_enter()",
        "@function_tool async consent_given() → complete(True)",
        "@function_tool async consent_declined() → complete(False)"
      ]
    },
    {
      "dot": "emerald",
      "title": "InterviewerAgent(Agent)  ·  interviewer.py",
      "items": [
        "vars: s: State",
        "__init__(s: State)",
        "async on_enter()",
        "async refresh()",
        "@function_tool async advance_to_next_question() → str | (ClosingAgent, str)",
        "@function_tool async lookup_company_info(question: str) → str"
      ]
    },
    {
      "dot": "emerald",
      "title": "ClosingAgent(Agent)  ·  interviewer.py",
      "items": [
        "vars: s: State",
        "__init__(s: State)",
        "async on_enter()",
        "@function_tool async lookup_company_info(question: str) → str",
        "@function_tool async end_interview()"
      ]
    },
