  "cards": [
    {
      "dot": "emerald",
      "title": "Handoffs",
      "items": [
        "InterviewerAgent.on_enter awaits ConsentTask before question 1",
        "advance_to_next_question returns ClosingAgent on the last question or when time_up is set",
        "ClosingAgent.end_interview drains TTS, then shutdown saves the transcript"
      ]
    },
    {
      "dot": "violet",
      "title": "Helpers",
      "items": [
        "Observer runs per candidate turn; its note refreshes the NEXT reply's instructions",
        "lookup_company_info fails closed to NO_ANSWER; OUT_OF_SCOPE wins over ANSWER",
        "run_timer sets time_up at cap − 90 s, forces goodbye at cap"
      ]
    },
    {
      "dot": "rose",
      "title": "Exits",
      "items": [
        "Declined consent: nothing is saved",
        "Hard cap interrupts, says GOODBYE, shuts down; transcript still saved"
      ]
    }
  ]
