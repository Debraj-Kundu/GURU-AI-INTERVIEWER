  "cards": [
    {
      "dot": "emerald",
      "title": "Handoffs",
      "items": [
        "entrypoint claims the session with POST /internal/sessions/{id}/start, which returns the plan",
        "InterviewerAgent.on_enter awaits ConsentTask before question 1",
        "advance_to_next_question (or candidate_wants_to_end) hands off to ClosingAgent",
        "On shutdown the agent saves out/<session_id>.json and POSTs /complete; the API scores in the background"
      ]
    },
    {
      "dot": "violet",
      "title": "Helpers",
      "items": [
        "Observer grades each answer; a newer turn on the same question cancels the older call",
        "lookup_company_info (InterviewerAgent and ClosingAgent) fails closed to NO_ANSWER; OUT_OF_SCOPE wins over ANSWER",
        "run_timer starts at consent_given: sets time_up at cap - 90 s, forces goodbye at cap"
      ]
    },
    {
      "dot": "rose",
      "title": "Exits",
      "items": [
        "409 from /start: interview already started elsewhere, leave without reporting",
        "Declined consent: reports consented=false, nothing is kept",
        "Candidate gone: 3 unanswered check-ins after 7 s silences, or no rejoin within 120 s",
        "Every exit after the claim runs the same shutdown report"
      ]
    }
  ]
