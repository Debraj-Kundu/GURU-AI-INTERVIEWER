# Copy to .env. LiveKit, OpenRouter, Gemini, Qdrant, and GURU_SERVICE_TOKEN are read from agent/.env.

# deploy/docker-compose.yml values (local dev only)
DATABASE_URL=postgresql+asyncpg://guru:guru@localhost:5432/guru
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=guru-uploads
# S3_REGION=us-east-1   # for real AWS S3: remove S3_ENDPOINT and use IAM keys

WEB_ORIGIN=http://localhost:3000

REDIS_URL=redis://localhost:6379/0  # Celery broker for the ingest workers
INVITE_TTL_MIN=10  # minutes a new link stays valid until the interview starts
